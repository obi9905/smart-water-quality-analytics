# ==============================================================================
# Smart Water Analytics Environment Variables Configuration
# Copy this file to .env for local runtime configuration
# NEVER COMMIT REAL API KEYS OR PRIVATE SERVICE ACCOUNT CREDENTIALS TO GIT
# ==============================================================================

# Google Cloud Platform Configuration
GCP_PROJECT_ID=smart-water-analytics-512816
BIGQUERY_DATASET=smart_water_analytics
GCS_BUCKET_NAME=smart-water-analytics-raw
GCP_REGION=us-central1

# Local Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=3000

# Zero-Cost Mode (True = BigQuery Sandbox without billing activation)
ZERO_COST_SANDBOX_MODE=true
